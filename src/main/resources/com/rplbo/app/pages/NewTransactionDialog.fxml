<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<VBox prefHeight="600.0" prefWidth="900.0" spacing="15.0" style="-fx-background-color: #1f1f1f;" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.rplbo.app.ui.NewTransactionController">
    <padding><Insets bottom="20" left="20" right="20" top="20" /></padding>
    <children>
        <Label text="Point of Sale - Transaksi Baru" style="-fx-text-fill: white; -fx-font-size: 20px; -fx-font-weight: 800;" />

        <HBox spacing="20.0" VBox.vgrow="ALWAYS">
            <children>
                <!-- LEFT: Search Section -->
                <VBox spacing="10.0" prefWidth="400.0">
                    <children>
                        <TextField fx:id="searchBar" promptText="Cari nama atau SKU produk..."
                                   style="-fx-background-color: #2b2b2b; -fx-text-fill: white; -fx-border-color: #4d667b; -fx-border-radius: 5; -fx-padding: 10;" />
                        <ListView fx:id="searchResultsList" VBox.vgrow="ALWAYS"
                                  style="-fx-background-color: #2b2b2b; -fx-control-inner-background: #2b2b2b;" />
                    </children>
                </VBox>

                <!-- RIGHT: Cart Section -->
                <VBox spacing="10.0" HBox.hgrow="ALWAYS">
                    <children>
                        <Label text="Informasi Transaksi" style="-fx-text-fill: #dbe7ef; -fx-font-weight: bold;"/>
                        <HBox spacing="10.0">
                            <children>
                                <TextField fx:id="custNameField" promptText="Nama Pelanggan" HBox.hgrow="ALWAYS"
                                           style="-fx-background-color: #1f1f1f; -fx-text-fill: white; -fx-border-color: #4d667b;"/>
                                <TextField fx:id="custPhoneField" promptText="No. Telepon" HBox.hgrow="ALWAYS"
                                           style="-fx-background-color: #1f1f1f; -fx-text-fill: white; -fx-border-color: #4d667b;"/>
                                <TextField fx:id="custEmailField" promptText="Email" HBox.hgrow="ALWAYS"
                                           style="-fx-background-color: #1f1f1f; -fx-text-fill: white; -fx-border-color: #4d667b;"/>
                                <TextField fx:id="custAddressField" promptText="Alamat Pelanggan" HBox.hgrow="ALWAYS"
                                           style="-fx-background-color: #1f1f1f; -fx-text-fill: white; -fx-border-color: #4d667b;"/>
                                <ComboBox fx:id="ecomCombo" promptText="Pilih Platform" prefWidth="150.0"
                                          style="-fx-background-color: #3d5062; -fx-text-fill: white;"/>
                            </children>
                        </HBox>
                        <TableView fx:id="cartTable" VBox.vgrow="ALWAYS" style="-fx-background-color: #4d667b; -fx-background-radius: 10;">
                            <columns>
                                <TableColumn fx:id="colName" prefWidth="200.0" text="Produk" />
                                <TableColumn fx:id="colPrice" prefWidth="100.0" text="Harga" />
                                <TableColumn fx:id="colQty" prefWidth="80.0" text="Qty" />
                                <TableColumn fx:id="colSubtotal" prefWidth="100.0" text="Subtotal" />
                            </columns>
                        </TableView>
                        <HBox alignment="CENTER_RIGHT" spacing="15.0">
                            <children>
                                <Label text="TOTAL:" style="-fx-text-fill: #dbe7ef; -fx-font-weight: 800; -fx-font-size: 18px;" />
                                <Label fx:id="totalLabel" text="Rp 0" style="-fx-text-fill: #79e07c; -fx-font-size: 24px; -fx-font-weight: 900;" />
                            </children>
                        </HBox>
                    </children>
                </VBox>
            </children>
        </HBox>

        <HBox alignment="CENTER_RIGHT" spacing="10.0">
            <children>
                <Button onAction="#handleCancel" text="Batal" style="-fx-background-color: transparent; -fx-text-fill: #8a98a4; -fx-font-weight: 800;" />
                <Button onAction="#handlePay" text="BAYAR SEKARANG"
                        style="-fx-background-color: #79e07c; -fx-text-fill: #1f2937; -fx-font-weight: 900; -fx-padding: 12 30; -fx-background-radius: 8;" />
            </children>
        </HBox>
    </children>
</VBox>