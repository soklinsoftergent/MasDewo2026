<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<VBox spacing="20.0" style="-fx-background-color: #1f1f1f;" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.rplbo.app.ui.SuppliersController">
    <padding><Insets bottom="20.0" left="20.0" right="20.0" top="10.0" /></padding>

    <!-- Top Action Bar -->
    <HBox alignment="CENTER_LEFT" spacing="15.0">
        <children>
            <TextField fx:id="searchField" prefWidth="300.0" promptText="Cari nama supplier..."
                       style="-fx-background-color: transparent; -fx-border-color: #4d667b; -fx-border-radius: 8; -fx-text-fill: white; -fx-padding: 10;" />
            <Region HBox.hgrow="ALWAYS" />
            <Button onAction="#handleShowAddDialog" text="+ Tambah Supplier"
                    style="-fx-background-color: #79e07c; -fx-text-fill: #1f2937; -fx-font-weight: 800; -fx-background-radius: 8; -fx-padding: 10 20; -fx-cursor: hand;" />
        </children>
    </HBox>

    <!-- Table Section -->
    <TableView fx:id="supplierTable" VBox.vgrow="ALWAYS" style="-fx-background-color: #2b2b2b; -fx-background-radius: 10;">
        <columns>
            <TableColumn fx:id="colId" prefWidth="60.0" text="ID" />
            <TableColumn fx:id="colName" prefWidth="200.0" text="Nama Perusahaan" />
            <TableColumn fx:id="colPhone" prefWidth="150.0" text="Telepon" />
            <TableColumn fx:id="colEmail" prefWidth="220.0" text="Email" />
            <TableColumn fx:id="colAddress" prefWidth="250.0" text="Alamat" />
            <TableColumn fx:id="colAction" prefWidth="100.0" text="Aksi" />
        </columns>
        <columnResizePolicy>
            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
        </columnResizePolicy>
    </TableView>
</VBox>