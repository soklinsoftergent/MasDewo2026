<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<VBox prefHeight="600.0" prefWidth="700.0" spacing="15.0" style="-fx-background-color: #1f1f1f;" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.rplbo.app.ui.EmployeeLogsController">
    <padding><Insets bottom="20" left="20" right="20" top="20" /></padding>
    <children>
        <HBox alignment="CENTER_LEFT" spacing="15.0">
            <children>
                <Label fx:id="headerLabel" text="Log Aktivitas: NamaUser" style="-fx-text-fill: white; -fx-font-size: 20px; -fx-font-weight: 800;" />
                <Region HBox.hgrow="ALWAYS" />
                <Button text="Tutup" onAction="#handleClose" style="-fx-background-color: transparent; -fx-text-fill: #8a98a4; -fx-border-color: #4d667b; -fx-border-radius: 5;" />
            </children>
        </HBox>

        <TableView fx:id="logTable" VBox.vgrow="ALWAYS" style="-fx-background-color: #2b2b2b; -fx-background-radius: 10;">
            <columns>
                <TableColumn fx:id="colWaktu" prefWidth="180.0" text="Waktu" />
                <TableColumn fx:id="colAksi" prefWidth="120.0" text="Aktivitas" />
                <TableColumn fx:id="colReferensi" prefWidth="150.0" text="Ref ID" />
                <TableColumn fx:id="colNominal" prefWidth="150.0" text="Nominal" />
            </columns>
            <columnResizePolicy>
                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
            </columnResizePolicy>
        </TableView>
    </children>
</VBox>