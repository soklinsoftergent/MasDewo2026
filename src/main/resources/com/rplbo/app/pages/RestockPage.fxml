<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<VBox spacing="20.0" style="-fx-background-color: #1f1f1f;" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.rplbo.app.ui.RestockController">
    <padding><Insets bottom="20.0" left="20.0" right="20.0" top="10.0" /></padding>

    <!-- Top: Search and Add -->
    <HBox spacing="15.0" alignment="CENTER_LEFT">
        <children>
            <TextField fx:id="productSearchField" prefWidth="350.0" promptText="Cari produk untuk di-restock..."
                       style="-fx-background-color: transparent; -fx-border-color: #4d667b; -fx-border-radius: 8; -fx-text-fill: white; -fx-padding: 10;" />
            <Button onAction="#handleAddToRestock" text="+ Tambah ke Daftar"
                    style="-fx-background-color: #4d667b; -fx-text-fill: white; -fx-font-weight: 800; -fx-background-radius: 8; -fx-padding: 10 20; -fx-cursor: hand;" />
            <Region HBox.hgrow="ALWAYS" />
            <Label text="RESTOK SUPPLIER" style="-fx-text-fill: #8a98a4; -fx-font-weight: 800; -fx-font-size: 14px;" />
        </children>
    </HBox>

    <!-- Center: The Table -->
    <TableView fx:id="restockTable" VBox.vgrow="ALWAYS" style="-fx-background-color: #2b2b2b; -fx-background-radius: 10;">
        <columns>
            <TableColumn fx:id="colItemName" prefWidth="250.0" text="Nama Produk" />
            <TableColumn fx:id="colQuantity" prefWidth="100.0" text="Jumlah" />
            <TableColumn fx:id="colUnitCost" prefWidth="150.0" text="Harga Modal (Satuan)" />
            <TableColumn fx:id="colSupplier" prefWidth="200.0" text="Supplier" />
            <TableColumn fx:id="colSubtotal" prefWidth="150.0" text="Subtotal" />
            <TableColumn fx:id="colAction" prefWidth="80.0" text="Hapus" />
        </columns>
        <columnResizePolicy>
            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
        </columnResizePolicy>
    </TableView>

    <!-- Bottom: Summary and Execution -->
    <HBox spacing="20.0" alignment="CENTER_RIGHT" style="-fx-background-color: #2b2b2b; -fx-padding: 20; -fx-background-radius: 12;">
        <children>
            <VBox alignment="CENTER_RIGHT">
                <Label text="TOTAL PENGELUARAN" style="-fx-text-fill: #dbe7ef; -fx-font-size: 12px; -fx-font-weight: 700;" />
                <Label fx:id="totalExpenseLabel" text="Rp. 0" style="-fx-text-fill: #ff8e8e; -fx-font-size: 28px; -fx-font-weight: 900;" />
            </VBox>
            <Button onAction="#handleExecuteRestock" text="KONFIRMASI &amp; BAYAR"
                    style="-fx-background-color: #79e07c; -fx-text-fill: #1f2937; -fx-font-weight: 900; -fx-font-size: 16px; -fx-background-radius: 8; -fx-padding: 15 30; -fx-cursor: hand;" />
        </children>
    </HBox>
</VBox>