<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox spacing="20.0" style="-fx-background-color: #1f1f1f;" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.rplbo.app.ui.EmployeesController">

    <!-- Top Action Bar -->
    <HBox alignment="CENTER_LEFT" spacing="15.0">
        <children>
            <TextField fx:id="searchField" prefWidth="300.0" promptText="Cari nama atau email karyawan..." style="-fx-background-color: transparent; -fx-border-color: #4d667b; -fx-border-radius: 8; -fx-text-fill: white; -fx-padding: 10;" />

            <Region HBox.hgrow="ALWAYS" />

            <Button fx:id="btnAddEmployee" onAction="#handleShowAddDialog" style="-fx-background-color: #79e07c; -fx-text-fill: #1f2937; -fx-font-weight: 800; -fx-background-radius: 8; -fx-padding: 10 20; -fx-cursor: hand;" text="+ Tambah Karyawan" />
        </children>
    </HBox>

    <!-- Employee Table Section -->
    <VBox style="-fx-background-color: #2b2b2b; -fx-background-radius: 15; -fx-padding: 10;" VBox.vgrow="ALWAYS">
        <children>
            <TableView fx:id="employeeTable" style="-fx-background-color: transparent; -fx-base: #2b2b2b; -fx-control-inner-background: #2b2b2b; -fx-table-cell-border-color: #3d5062;" VBox.vgrow="ALWAYS">
                <columns>
                    <TableColumn fx:id="colId" prefWidth="60.0" text="ID" />
                    <TableColumn fx:id="colUsername" prefWidth="150.0" text="Username" />
                    <TableColumn fx:id="colEmail" prefWidth="220.0" text="Email" />
                    <TableColumn fx:id="colRole" prefWidth="120.0" text="Peran" />
                    <TableColumn fx:id="colStatus" prefWidth="120.0" text="Status" />
                    <TableColumn fx:id="colAction" prefWidth="150.0" text="Aksi" />
                </columns>
                <columnResizePolicy>
                    <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                </columnResizePolicy>
            </TableView>
        </children>
    </VBox>

    <!-- Summary Stats Footer -->
    <HBox spacing="20.0">
        <children>
            <HBox alignment="CENTER_LEFT" spacing="10.0" style="-fx-background-color: #4d667b; -fx-padding: 15; -fx-background-radius: 10;">
                <children>
                    <Label style="-fx-text-fill: #dbe7ef; -fx-font-weight: 700;" text="Total Karyawan:" />
                    <Label fx:id="totalEmployeesLabel" style="-fx-text-fill: white; -fx-font-size: 18px; -fx-font-weight: 900;" text="0" />
                </children>
            </HBox>

            <HBox alignment="CENTER_LEFT" spacing="10.0" style="-fx-background-color: #4d667b; -fx-padding: 15; -fx-background-radius: 10;">
                <children>
                    <Label style="-fx-text-fill: #dbe7ef; -fx-font-weight: 700;" text="Staff Aktif:" />
                    <Label fx:id="activeStaffLabel" style="-fx-text-fill: #79e07c; -fx-font-size: 18px; -fx-font-weight: 900;" text="0" />
                </children>
            </HBox>
        </children>
    </HBox>
</VBox>
