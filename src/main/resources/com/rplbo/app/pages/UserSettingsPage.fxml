<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.shape.*?>
<?import javafx.geometry.Insets?>

<VBox spacing="20.0" style="-fx-background-color: #1f1f1f;" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.rplbo.app.ui.UserSettingsController">
    <padding>
        <Insets bottom="20.0" left="20.0" right="20.0" top="10.0" />
    </padding>

    <!-- TOP SECTION: Profile Overview Card -->
    <HBox spacing="25.0" style="-fx-background-color: #4d667b; -fx-background-radius: 15; -fx-padding: 30;">
        <children>
            <!-- Large Avatar -->
            <StackPane>
                <children>
                    <Circle fill="#87c47c" radius="50.0" stroke="TRANSPARENT" />
                    <Label fx:id="avatarLabel" text="AD" style="-fx-text-fill: white; -fx-font-size: 36px; -fx-font-weight: 900;" />
                </children>
            </StackPane>

            <VBox spacing="5.0" alignment="CENTER_LEFT">
                <children>
                    <HBox spacing="10.0" alignment="CENTER_LEFT">
                        <Label fx:id="displayNameLabel" text="Administrator" style="-fx-text-fill: white; -fx-font-size: 28px; -fx-font-weight: 800;" />
                        <Label fx:id="roleBadge" text="ADMIN" style="-fx-background-color: #d8c3ff; -fx-text-fill: #6d4ab5; -fx-padding: 4 12; -fx-background-radius: 6; -fx-font-weight: 800; -fx-font-size: 11px;" />
                    </HBox>
                    <Label fx:id="displayEmailLabel" text="admin@masdewo.com" style="-fx-text-fill: #dbe7ef; -fx-font-size: 14px;" />
                    <Label fx:id="lastLoginLabel" text="Terakhir login: Hari ini, 20:45" style="-fx-text-fill: #8a98a4; -fx-font-size: 11px; -fx-padding: 5 0 0 0;" />
                </children>
            </VBox>

            <Region HBox.hgrow="ALWAYS" />

            <Button onAction="#handleLogout" text="Log Out" style="-fx-background-color: transparent; -fx-border-color: #ff8e8e; -fx-border-radius: 8; -fx-text-fill: #ff8e8e; -fx-font-weight: 800; -fx-padding: 10 20; -fx-cursor: hand;" />
        </children>
    </HBox>

    <!-- BOTTOM SECTION: Edit Forms -->
    <HBox spacing="20.0" VBox.vgrow="ALWAYS">
        <children>
            <!-- Update Profile Form -->
            <VBox spacing="15.0" HBox.hgrow="ALWAYS" style="-fx-background-color: #2b2b2b; -fx-background-radius: 12; -fx-padding: 25;">
                <children>
                    <Label text="Detail Akun" style="-fx-text-fill: white; -fx-font-size: 18px; -fx-font-weight: 800;" />

                    <VBox spacing="5.0">
                        <Label text="Username" style="-fx-text-fill: #8a98a4; -fx-font-size: 12px; -fx-font-weight: 700;" />
                        <TextField fx:id="usernameField" style="-fx-background-color: #1f1f1f; -fx-text-fill: white; -fx-border-color: #4d667b; -fx-border-radius: 5; -fx-padding: 10;" />
                    </VBox>

                    <VBox spacing="5.0">
                        <Label text="Email" style="-fx-text-fill: #8a98a4; -fx-font-size: 12px; -fx-font-weight: 700;" />
                        <TextField fx:id="emailField" style="-fx-background-color: #1f1f1f; -fx-text-fill: white; -fx-border-color: #4d667b; -fx-border-radius: 5; -fx-padding: 10;" />
                    </VBox>

                    <VBox spacing="5.0">
                        <Label text="Nomor Telepon" style="-fx-text-fill: #8a98a4; -fx-font-size: 12px; -fx-font-weight: 700;" />
                        <TextField fx:id="phoneField" style="-fx-background-color: #1f1f1f; -fx-text-fill: white; -fx-border-color: #4d667b; -fx-border-radius: 5; -fx-padding: 10;" />
                    </VBox>

                    <Region VBox.vgrow="ALWAYS" />
                    <Button onAction="#handleSaveProfile" maxWidth="1.7976931348623157E308" text="Simpan Perubahan" style="-fx-background-color: #4d667b; -fx-text-fill: white; -fx-font-weight: 800; -fx-padding: 12; -fx-background-radius: 8; -fx-cursor: hand;" />
                </children>
            </VBox>

            <!-- Change Password Form -->
            <VBox spacing="15.0" HBox.hgrow="ALWAYS" style="-fx-background-color: #2b2b2b; -fx-background-radius: 12; -fx-padding: 25;">
                <children>
                    <Label text="Ubah Password" style="-fx-text-fill: white; -fx-font-size: 18px; -fx-font-weight: 800;" />

                    <VBox spacing="5.0">
                        <Label text="Password Saat Ini" style="-fx-text-fill: #8a98a4; -fx-font-size: 12px; -fx-font-weight: 700;" />
                        <PasswordField fx:id="currentPasswordField" style="-fx-background-color: #1f1f1f; -fx-text-fill: white; -fx-border-color: #4d667b; -fx-border-radius: 5; -fx-padding: 10;" />
                    </VBox>

                    <VBox spacing="5.0">
                        <Label text="Password Baru" style="-fx-text-fill: #8a98a4; -fx-font-size: 12px; -fx-font-weight: 700;" />
                        <PasswordField fx:id="newPasswordField" style="-fx-background-color: #1f1f1f; -fx-text-fill: white; -fx-border-color: #4d667b; -fx-border-radius: 5; -fx-padding: 10;" />
                    </VBox>

                    <VBox spacing="5.0">
                        <Label text="Konfirmasi Password Baru" style="-fx-text-fill: #8a98a4; -fx-font-size: 12px; -fx-font-weight: 700;" />
                        <PasswordField fx:id="confirmPasswordField" style="-fx-background-color: #1f1f1f; -fx-text-fill: white; -fx-border-color: #4d667b; -fx-border-radius: 5; -fx-padding: 10;" />
                    </VBox>

                    <Region VBox.vgrow="ALWAYS" />
                    <Button onAction="#handleUpdatePassword" maxWidth="1.7976931348623157E308" text="Update Password" style="-fx-background-color: #79e07c; -fx-text-fill: #1f2937; -fx-font-weight: 800; -fx-padding: 12; -fx-background-radius: 8; -fx-cursor: hand;" />
                </children>
            </VBox>
        </children>
    </HBox>
</VBox>